# Token from Meta App Dashboard > WhatsApp > API Setup (use a permanent System User token for production)
WHATSAPP_TOKEN=

# Phone Number ID from Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=

# Any string you choose yourself - must match what you enter in Meta's webhook setup screen
VERIFY_TOKEN=

# Uri's own WhatsApp number in international format, no plus sign, no spaces (e.g. 972527338868)
OWNER_PHONE=972527338868

# Port the server listens on - most hosts (Railway, Render) set this automatically
PORT=3000
